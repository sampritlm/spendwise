# SpendWise - AWS Serverless Environment Configuration Example
# Set your Amazon API Gateway HTTP API invoke URL below
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com

# Set to 'false' when connecting to live AWS Lambda endpoints
VITE_USE_MOCK_API=true

# AWS Region for CloudWatch / DynamoDB reference
VITE_AWS_REGION=ap-south-1

